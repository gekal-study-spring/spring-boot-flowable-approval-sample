<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://flowable.org/processdef">

    <!-- ============================================================
         個人ローンの審査プロセス。

         経費精算（expense-approval）が単純な多段承認の例なのに対し、こちらは実務で出てくる
         次の構造をひと通り含める:

           - 書類不備での差戻しと再提出（ループ）
           - 信用情報照会と反社チェックの並行実行（Parallel Gateway）
           - スコアによる自動謝絶・自動承認・人手審査の振り分け
           - 金額で決裁段数が変わる多段承認
           - 契約締結の期限切れ失効（中断型の境界タイマー）

         この段階では外部連携はスタブで、判定ロジックは LoanScreeningPolicy に置いている。
         申込内容は暫定でプロセス変数に載せているが、個人情報を履歴へ残さないため、
         実運用では業務テーブルへ移して applicationId だけを持たせる（docs 参照）。
         ============================================================ -->
    <process id="loanScreeningProcess" name="個人ローン審査プロセス" isExecutable="true">

        <startEvent id="startLoanApplication" name="ローン申込受付" flowable:initiator="applicantId"/>
        <sequenceFlow id="flowStartToDocumentCheck" sourceRef="startLoanApplication" targetRef="userTaskDocumentCheck"/>

        <!-- ========== 書類確認と差戻し ========== -->
        <userTask id="userTaskDocumentCheck" name="書類確認"
                  flowable:candidateGroups="loanClerks"
                  flowable:formKey="loanDocumentCheckForm">
            <documentation>本人確認書類と収入証明の有無を確認する。不備があれば申込者へ差し戻す。</documentation>
            <extensionElements>
                <flowable:formProperty id="documentsComplete" name="書類の充足" type="boolean" required="true"/>
                <flowable:formProperty id="documentNote" name="不備の内容" type="string"/>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flowDocumentCheckToGateway" sourceRef="userTaskDocumentCheck" targetRef="gatewayDocumentsComplete"/>

        <exclusiveGateway id="gatewayDocumentsComplete" name="書類判定" default="flowDocumentsIncomplete"/>

        <sequenceFlow id="flowDocumentsIncomplete" name="不備あり"
                      sourceRef="gatewayDocumentsComplete" targetRef="userTaskAdditionalDocuments"/>
        <sequenceFlow id="flowDocumentsComplete" name="不備なし"
                      sourceRef="gatewayDocumentsComplete" targetRef="gatewayScreeningFork">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${documentsComplete}]]></conditionExpression>
        </sequenceFlow>

        <!-- 申込者へ差し戻す。再提出されたら書類確認へ戻り、何度でも回りうる -->
        <userTask id="userTaskAdditionalDocuments" name="追加書類の提出"
                  flowable:assignee="${applicantId}"
                  flowable:formKey="loanAdditionalDocumentsForm">
            <documentation>不備を申込者へ通知し、再提出を待つ。</documentation>
        </userTask>
        <sequenceFlow id="flowAdditionalDocumentsToRecheck"
                      sourceRef="userTaskAdditionalDocuments" targetRef="userTaskDocumentCheck"/>

        <!-- ========== 外部照会（並行） ========== -->
        <parallelGateway id="gatewayScreeningFork" name="照会開始"/>
        <sequenceFlow id="flowForkToBureau" sourceRef="gatewayScreeningFork" targetRef="serviceTaskCreditBureauInquiry"/>
        <sequenceFlow id="flowForkToSanction" sourceRef="gatewayScreeningFork" targetRef="serviceTaskSanctionScreening"/>

        <serviceTask id="serviceTaskCreditBureauInquiry" name="信用情報照会"
                     flowable:delegateExpression="${creditBureauInquiryDelegate}"
                     flowable:async="true" flowable:exclusive="false">
            <documentation>信用情報機関へ照会し、スコアと事故情報を取得する。</documentation>
            <extensionElements>
                <flowable:field name="bureauCode"><flowable:string><![CDATA[CREDIT_BUREAU_A]]></flowable:string></flowable:field>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flowBureauToJoin" sourceRef="serviceTaskCreditBureauInquiry" targetRef="gatewayScreeningJoin"/>

        <serviceTask id="serviceTaskSanctionScreening" name="反社・制裁リスト照合"
                     flowable:delegateExpression="${sanctionScreeningDelegate}"
                     flowable:async="true" flowable:exclusive="false">
            <documentation>反社会的勢力および制裁リストとの照合を行う。</documentation>
            <extensionElements>
                <flowable:field name="listCode"><flowable:string><![CDATA[SANCTION_LIST]]></flowable:string></flowable:field>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flowSanctionToJoin" sourceRef="serviceTaskSanctionScreening" targetRef="gatewayScreeningJoin"/>

        <!-- 両方の照会がそろうまで待つ -->
        <parallelGateway id="gatewayScreeningJoin" name="照会合流"/>
        <sequenceFlow id="flowJoinToScoring" sourceRef="gatewayScreeningJoin" targetRef="serviceTaskCreditScoring"/>

        <!-- ========== 与信スコアリング ========== -->
        <serviceTask id="serviceTaskCreditScoring" name="与信スコアリング"
                     flowable:delegateExpression="${creditScoringDelegate}">
            <documentation>照会結果と申込内容から、自動謝絶・自動承認・人手審査のいずれかを決める。</documentation>
        </serviceTask>
        <sequenceFlow id="flowScoringToDecision" sourceRef="serviceTaskCreditScoring" targetRef="gatewayCreditDecision"/>

        <exclusiveGateway id="gatewayCreditDecision" name="与信判定" default="flowDecisionToManual"/>

        <sequenceFlow id="flowDecisionToAutoDecline" name="自動謝絶"
                      sourceRef="gatewayCreditDecision" targetRef="serviceTaskDeclineNotification">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${creditDecision == 'AUTO_DECLINE'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowDecisionToAutoApprove" name="自動承認"
                      sourceRef="gatewayCreditDecision" targetRef="serviceTaskContractPreparation">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${creditDecision == 'AUTO_APPROVE'}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowDecisionToManual" name="人手審査"
                      sourceRef="gatewayCreditDecision" targetRef="userTaskAnalystReview"/>

        <!-- ========== 人手審査（金額で決裁段数が変わる） ========== -->
        <userTask id="userTaskAnalystReview" name="審査担当者レビュー"
                  flowable:candidateGroups="loanAnalysts"
                  flowable:formKey="loanReviewForm">
            <extensionElements>
                <flowable:formProperty id="approved" name="承認可否" type="boolean" required="true"/>
                <flowable:formProperty id="approvalComment" name="所見" type="string"/>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flowAnalystToManager" sourceRef="userTaskAnalystReview" targetRef="userTaskManagerApproval"/>

        <userTask id="userTaskManagerApproval" name="課長決裁"
                  flowable:candidateGroups="loanManagers"
                  flowable:formKey="loanReviewForm">
            <extensionElements>
                <flowable:formProperty id="approved" name="承認可否" type="boolean" required="true"/>
                <flowable:formProperty id="approvalComment" name="所見" type="string"/>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flowManagerToLevelGateway" sourceRef="userTaskManagerApproval" targetRef="gatewayApprovalLevel"/>

        <exclusiveGateway id="gatewayApprovalLevel" name="決裁区分判定" default="flowLevelToJoin"/>
        <sequenceFlow id="flowLevelToExecutive" name="500万円以上"
                      sourceRef="gatewayApprovalLevel" targetRef="userTaskExecutiveApproval">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${loanScreeningPolicy.requiresExecutiveApproval(requestedAmountYen)}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowLevelToJoin" name="500万円未満"
                      sourceRef="gatewayApprovalLevel" targetRef="gatewayApprovalJoin"/>

        <userTask id="userTaskExecutiveApproval" name="部長決裁"
                  flowable:candidateGroups="loanExecutives"
                  flowable:formKey="loanReviewForm">
            <extensionElements>
                <flowable:formProperty id="approved" name="承認可否" type="boolean" required="true"/>
                <flowable:formProperty id="approvalComment" name="所見" type="string"/>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flowExecutiveToJoin" sourceRef="userTaskExecutiveApproval" targetRef="gatewayApprovalJoin"/>

        <exclusiveGateway id="gatewayApprovalJoin" name="決裁合流"/>
        <sequenceFlow id="flowApprovalJoinToFinal" sourceRef="gatewayApprovalJoin" targetRef="gatewayFinalDecision"/>

        <exclusiveGateway id="gatewayFinalDecision" name="最終判定" default="flowFinalToDecline"/>
        <sequenceFlow id="flowFinalToContract" name="承認"
                      sourceRef="gatewayFinalDecision" targetRef="serviceTaskContractPreparation">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowFinalToDecline" name="否決"
                      sourceRef="gatewayFinalDecision" targetRef="serviceTaskDeclineNotification"/>

        <!-- ========== 契約と実行 ========== -->
        <serviceTask id="serviceTaskContractPreparation" name="契約書作成"
                     flowable:delegateExpression="${contractPreparationDelegate}">
            <documentation>契約番号を採番し、契約書を用意する。</documentation>
        </serviceTask>
        <sequenceFlow id="flowContractPrepToSigning" sourceRef="serviceTaskContractPreparation" targetRef="userTaskContractSigning"/>

        <userTask id="userTaskContractSigning" name="顧客の契約締結"
                  flowable:assignee="${applicantId}"
                  flowable:formKey="loanContractForm">
            <documentation>申込者による契約締結を待つ。期限を過ぎたら申込を失効させる。</documentation>
        </userTask>

        <!-- 中断型の境界タイマー。経費精算のリマインドと違い、発火するとタスクを打ち切る -->
        <boundaryEvent id="timerContractExpiry" name="14日で失効"
                       attachedToRef="userTaskContractSigning" cancelActivity="true">
            <timerEventDefinition>
                <timeDuration>P14D</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>
        <sequenceFlow id="flowExpiryToEnd" sourceRef="timerContractExpiry" targetRef="endEventExpired"/>
        <endEvent id="endEventExpired" name="期限切れ失効"/>

        <sequenceFlow id="flowSigningToExecution" sourceRef="userTaskContractSigning" targetRef="serviceTaskLoanExecution"/>

        <serviceTask id="serviceTaskLoanExecution" name="融資実行"
                     flowable:delegateExpression="${loanExecutionDelegate}"
                     flowable:async="true" flowable:exclusive="true">
            <documentation>勘定系へ融資実行を連携する。</documentation>
            <extensionElements>
                <flowable:field name="endpointKey"><flowable:string><![CDATA[core.loan.execution]]></flowable:string></flowable:field>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flowExecutionToEnd" sourceRef="serviceTaskLoanExecution" targetRef="endEventFunded"/>
        <endEvent id="endEventFunded" name="融資実行完了"/>

        <!-- ========== 謝絶 ========== -->
        <serviceTask id="serviceTaskDeclineNotification" name="謝絶通知"
                     flowable:delegateExpression="${declineNotificationDelegate}">
            <documentation>謝絶理由を添えて申込者へ通知する。</documentation>
        </serviceTask>
        <sequenceFlow id="flowDeclineToEnd" sourceRef="serviceTaskDeclineNotification" targetRef="endEventDeclined"/>
        <endEvent id="endEventDeclined" name="謝絶"/>

    </process>

