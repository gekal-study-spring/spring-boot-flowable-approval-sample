{
  "name": "expense-approval-web",
  "private": true,
  "version": "0.0.1",
  "description": "経費精算承認サンプルの動作確認コンソール（Next.js 静的書き出し + MUI）",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:app": "next build && rm -rf ../app/src/main/resources/static && mkdir -p ../app/src/main/resources/static && cp -R out/. ../app/src/main/resources/static/",
    "preview": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "bpmn-js": "^18.25.1",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "serve": "^14.0.0",
    "tsx": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
