### 5. 申請状態（リマインド後も承認タスクは残る = 非中断型）
GET {{ host }}/api/expense-requests/{{ managerRoutePid }}
Authorization: Basic {{ applicantUser }} {{ password }}
Accept: application/json

> {%
    client.test("リマインドされても承認待ちのまま", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "IN_PROGRESS", "status: " + response.body.status);
        client.assert(response.body.currentTaskName === "課長承認", "task: " + response.body.currentTaskName);
        // リマインドの実行は非同期エグゼキュータが行うため、直後は 0 のこともある
        client.assert(response.body.reminderCount === 0 || response.body.reminderCount === 1,
            "reminderCount: " + response.body.reminderCount);
    });
%}

