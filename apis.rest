### 7. 申請状態（基幹システム連携は非同期 Service Task なので少し遅れて反映される）
GET {{ host }}/api/expense-requests/{{ managerRoutePid }}
Authorization: Basic {{ applicantUser }} {{ password }}
Accept: application/json

> {%
    client.test("連携完了後は APPROVED になり伝票番号が入る", function () {
        client.assert(response.status === 200, "status: " + response.status);
        if (response.body.status === "APPROVED") {
            client.assert(response.body.erpVoucherNo !== null, "伝票番号が入っていない");
            client.assert(response.body.endedAt !== null, "完了日時が入っていない");
        } else {
            // ジョブ実行前。数秒おいてこのリクエストを再実行すると APPROVED になる
            client.assert(response.body.status === "IN_PROGRESS", "status: " + response.body.status);
        }
    });
%}

### 7.5 承認履歴（誰がいつ何をしたか）
GET {{ host }}/api/expense-requests/{{ managerRoutePid }}/history
Authorization: Basic {{ applicantUser }} {{ password }}
Accept: application/json

> {%
    client.test("申請・承認タスク・自動処理が発生順に並ぶ", function () {
        client.assert(response.status === 200, "status: " + response.status);
        const names = response.body.map(e => e.name);
        client.assert(names[0] === "経費精算申請", "先頭が申請ではない: " + names[0]);
        client.assert(names.includes("課長承認"), "課長承認が履歴にない: " + names);
        // ゲートウェイや sequenceFlow は履歴に出さない
        client.assert(response.body.every(e => ["APPLICATION", "APPROVAL_TASK", "SYSTEM_TASK"].includes(e.type)),
            "想定外の種別が混ざっている");
    });
    client.test("承認タスクに実施者・所要時間・コメントが残る", function () {
        const approval = response.body.find(e => e.type === "APPROVAL_TASK");
        client.assert(approval.assignee === "sato", "assignee: " + approval.assignee);
        client.assert(approval.durationMillis !== null, "所要時間が入っていない");
        client.assert(approval.comments.length === 1, "コメント件数: " + approval.comments.length);
        client.assert(approval.comments[0].message === "問題ありません",
            "コメント: " + approval.comments[0].message);
        client.assert(approval.comments[0].author === "sato",
            "記入者: " + approval.comments[0].author);
    });
%}

### 7.6 承認フロー図（BPMN 定義と、どこまで進んだか）
GET {{ host }}/api/expense-requests/{{ managerRoutePid }}/diagram
Authorization: Basic {{ applicantUser }} {{ password }}
Accept: application/json

> {%
    client.test("BPMN 定義と通過経路が返る", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.bpmnXml.includes("expenseApprovalProcess"), "BPMN 定義が入っていない");
        client.assert(response.body.bpmnXml.includes("BPMNDiagram"), "図形情報が入っていない");
        client.assert(response.body.completedActivityIds.includes("startExpenseRequest"),
            "通過済み: " + response.body.completedActivityIds);
        // 10万円未満なので課長側の経路だけを通る
        client.assert(response.body.takenFlowIds.includes("flowAmountToManager"),
            "通過フロー: " + response.body.takenFlowIds);
        client.assert(!response.body.takenFlowIds.includes("flowAmountToDirector"),
            "部長ルートを通ったことになっている");
    });
%}

