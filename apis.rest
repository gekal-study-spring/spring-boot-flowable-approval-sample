### 経費精算承認サンプル API
###
### 上から順に実行すると、承認ルート・却下ルート・リマインド・エラー系までひと通り確認できる。
### 各リクエストにはレスポンス検証（client.test）を付けてあるので、テストとしてまとめ実行してもよい。
###
### 起動方法により接続先が変わる:
###   ./gradlew app:bootRun     -> http://localhost:8080
###   docker compose up --build -> http://localhost:18080（app 直叩き）
###                             -> https://local.gekal.cn（web サービス経由）
@host = http://localhost:8080
@applicantUser = yamada
@managerUser = sato
@directorUser = tanaka
@password = password

### 0. ヘルスチェック（認証不要）
GET {{ host }}/actuator/health
Accept: application/json

> {%
    client.test("ヘルスチェックが UP を返す", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.status === "UP", "status: " + response.body.status);
    });
%}

### 1. 申請（5万円 → 課長ルート）
# @name createManagerRouteRequest
POST {{ host }}/api/expense-requests
Authorization: Basic {{ applicantUser }} {{ password }}
Content-Type: application/json
Accept: application/json

{
  "title": "9月出張旅費",
  "amount": 50000,
  "expenseDate": "2026-08-18",
  "category": "旅費交通費",
  "remarks": "新幹線往復"
}

> {%
    client.test("10万円未満は課長承認へ回る", function () {
        client.assert(response.status === 201, "status: " + response.status);
        client.assert(response.body.status === "IN_PROGRESS", "status: " + response.body.status);
        client.assert(response.body.currentTaskName === "課長承認", "task: " + response.body.currentTaskName);
        client.assert(response.body.applicantId === "yamada", "applicant: " + response.body.applicantId);
    });
    client.global.set("managerRoutePid", response.body.processInstanceId);
%}

### 2. 課長の承認タスク一覧（1 の申請が含まれる）
# @name managerTasks
GET {{ host }}/api/tasks
Authorization: Basic {{ managerUser }} {{ password }}
Accept: application/json

> {%
    const pid = client.global.get("managerRoutePid");
    const task = response.body.find(t => t.processInstanceId === pid);
    client.test("課長に承認タスクが割り当たっている", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(task !== undefined, "対象の承認タスクが一覧にない: " + pid);
        client.assert(task.role === "MANAGER", "role: " + task.role);
        client.assert(task.assignee === null, "未引き受けのはず: " + task.assignee);
    });
    client.global.set("managerTaskId", task ? task.taskId : "");
%}

### 3. 部長の承認タスク一覧（1 の申請は含まれない）
GET {{ host }}/api/tasks
Authorization: Basic {{ directorUser }} {{ password }}
Accept: application/json

> {%
    const pid = client.global.get("managerRoutePid");
    client.test("10万円未満の申請は部長には見えない", function () {
        client.assert(response.status === 200, "status: " + response.status);
        client.assert(response.body.find(t => t.processInstanceId === pid) === undefined,
            "部長の一覧に課長ルートの申請が混ざっている");
